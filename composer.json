{
    "name": "daryl-peterson/librenms-tickets",
    "description": "LibreNMS plugin for trouble tickets",
    "keywords": [
        "librenms",
        "plugin",
        "tickets plugin",
        "tickets",
        "csv"
    ],
    "type": "package",
    "license": "MIT",
    "authors": [
        {
            "name": "daryl-peterson",
            "email": "daryl.peterson@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "librenms/plugin-interfaces": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "DRP\\Tickets\\": "src/"
        },
        "files": [
            "./helpers.php"
        ]
    },
     "extra": {
        "laravel": {
            "providers": [
                "DRP\\Tickets\\TicketServiceProvider"
            ],
            "aliases": {
                "Tickets": "DRP\\Tickets\\Facade"
            }
        }
    },
    "minimum-stability": "dev"

}
